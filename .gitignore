# Unity .gitignore — Pakettipörinä

# Unityn luomat kansiot (eivät versionhallintaan)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset-meta-tiedostot tyhjille kansioille (jätetään pois)
/[Aa]ssets/[Aa]ssetStoreTools*

# Visual Studio / Rider / IDE
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.tmp

# Build-tulokset
*.apk
*.aab
*.unitypackage
*.app

# Käyttöjärjestelmä
.DS_Store
Thumbs.db

# Crashlogs
sysinfo.txt
crashlytics-build.properties

# HUOM: Unityn .meta-tiedostot KUULUVAT versionhallintaan — älä jätä niitä pois.

# Siivottu roska
UpgradeLog*.htm
*_BurstDebugInformation_DoNotShip/
create_pakettiporina_structure.ps1
.preview_*.png

# --- Suunnitelmat ja sisäiset dokumentit eivät kuulu julkiseen repoon (24.11.2026) ---
# Docs/ pidetään vain paikallisesti; README:n kuvat (Docs/Esittely/*.png, *.gif) on poikkeus.
/Docs/*
!/Docs/Esittely/
/Docs/Esittely/*
!/Docs/Esittely/*.png
!/Docs/Esittely/*.gif
# Tuotesuunnitelma, GDD ja ideakuvat
/Idea/
