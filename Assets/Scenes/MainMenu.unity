      m_Calls: []
  m_text: "Pakettiporina ei ker\xE4\xE4 tietoja sinusta.\n\n<b>Ei mainoksia</b> -
    peliss\xE4 ei n\xE4ytet\xE4 yht\xE4\xE4n mainosta.\n\n<b>Ei datankeruuta</b>
    - peli ei l\xE4het\xE4 mit\xE4\xE4n tietoja internetiin eik\xE4 seuraa pelaamista.\n\n<b>Toimii
    ilman netti\xE4</b> - kaikki tallennukset (pisteet, autosi osat, tarrat) s\xE4ilyv\xE4t
    vain t\xE4ss\xE4 laitteessa, ei miss\xE4\xE4n palvelimella.\n\n<b>Turvallinen
    lapsille</b> - ei osto- tai chat-toimintoja. Ainoa nettiyhteytt\xE4 k\xE4ytt\xE4v\xE4
    toiminto on \"Tietoja\"-paneelin palautekortti, joka avaa laitteen omaa s\xE4hk\xF6postisovellusta
    vasta kun sit\xE4 erikseen napautetaan."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
